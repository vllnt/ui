{
  "extends": "@vllnt/typescript/react.json",
  "compilerOptions": {
    "exactOptionalPropertyTypes": false,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.json",
    "app/.well-known/**/*.ts",
    "next-env.d.ts"
  ],
  "exclude": ["node_modules", "registry/**"]
}
