{
  "name": "@vllnt/ui-registry",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm registry:sync-shims",
    "dev": "next dev",
    "build": "pnpm registry:build && pnpm i18n:check && pnpm components:verify-mdx && next build && pnpm search:index",
    "clean": "rm -rf .next node_modules public/r public/_pagefind",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:once": "vitest run",
    "test:e2e": "playwright test",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "components:generate-mdx": "tsx scripts/generate-component-mdx.ts",
    "components:verify-mdx": "tsx scripts/verify-component-mdx.ts",
    "registry:build": "tsx scripts/inline-component-source.ts && shadcn build && tsx scripts/stamp-registry-metadata.ts && tsx scripts/generate-component-metadata.ts",
    "registry:sync-shims": "tsx scripts/inline-component-source.ts",
    "registry:check": "tsx scripts/check-registry-drift.ts",
    "registry:integrity": "tsx scripts/check-registry-integrity.ts",
    "registry:verify-previews": "tsx scripts/verify-preview-stories.ts",
    "search:index": "pagefind --site .next/server/app --output-path public/_pagefind --root-selector main",
    "sync-storybook": "tsx scripts/generate-component-metadata.ts"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@next/mdx": "16.4.3",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "@vllnt/next-llms": "0.1.0-canary.bfc9152",
    "@vllnt/ui": "workspace:*",
    "@vllnt/ui-core": "workspace:*",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "next-intl": "4.13.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "canary",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vllnt/eslint-config": "^2.0.0",
    "@vllnt/typescript": "^2.0.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  }
}
