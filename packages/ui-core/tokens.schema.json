{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VLLNT UI design tokens",
  "type": "object",
  "required": [
    "name",
    "version",
    "source",
    "color",
    "brand",
    "typography",
    "spacing",
    "radius",
    "size",
    "opacity",
    "elevation",
    "shadow",
    "blur",
    "material",
    "depth",
    "motion",
    "iconography",
    "themes"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "const": "VLLNT UI" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "source": {
      "type": "object",
      "required": ["guide", "theme"],
      "properties": {
        "guide": { "type": "string" },
        "theme": { "type": "string" }
      },
      "additionalProperties": false
    },
    "color": {
      "type": "object",
      "required": ["format", "semantic"],
      "properties": {
        "format": { "const": "oklch-channel" },
        "semantic": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/semanticColor" }
        },
        "glass-border": { "$ref": "#/$defs/modeColor" },
        "glass-input": { "$ref": "#/$defs/modeColor" },
        "glass-muted-foreground": { "$ref": "#/$defs/modeColor" },
        "badge-label": { "$ref": "#/$defs/tokenGroup" }
      },
      "additionalProperties": false
    },
    "brand": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/tokenGroup" }
      },
      "additionalProperties": false
    },
    "typography": {
      "type": "object",
      "required": ["fontFamily", "fontWeight", "scale"],
      "properties": {
        "fontFamily": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/fontFamily" }
        },
        "fontWeight": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/fontWeight" }
        },
        "scale": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/typeScale" }
        }
      },
      "additionalProperties": false
    },
    "spacing": {
      "type": "object",
      "required": [
        "unit",
        "scale",
        "page-gutter",
        "page-gutter-tablet",
        "page-gutter-desktop"
      ],
      "properties": {
        "unit": { "$ref": "#/$defs/cssLength" },
        "scale": { "$ref": "#/$defs/stringMap" },
        "page-gutter": { "$ref": "#/$defs/token" },
        "page-gutter-tablet": { "$ref": "#/$defs/token" },
        "page-gutter-desktop": { "$ref": "#/$defs/token" }
      },
      "additionalProperties": false
    },
    "radius": { "$ref": "#/$defs/stringMap" },
    "size": { "$ref": "#/$defs/tokenGroup" },
    "opacity": { "$ref": "#/$defs/tokenGroup" },
    "elevation": { "$ref": "#/$defs/stringMap" },
    "shadow": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/shadowToken" }
    },
    "blur": {
      "type": "object",
      "required": ["glass"],
      "properties": { "glass": { "$ref": "#/$defs/tokenGroup" } },
      "additionalProperties": false
    },
    "material": {
      "type": "object",
      "required": ["glass", "highlight", "solid"],
      "properties": {
        "glass": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [
              { "$ref": "#/$defs/token" },
              { "$ref": "#/$defs/tokenGroup" },
              { "$ref": "#/$defs/modeToken" }
            ]
          }
        },
        "highlight": {
          "type": "object",
          "required": ["top"],
          "properties": { "top": { "$ref": "#/$defs/modeColor" } },
          "additionalProperties": false
        },
        "solid": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z0-9.-]*$" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "depth": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^z-[0-9]+$" },
      "additionalProperties": { "$ref": "#/$defs/tokenGroup" }
    },
    "motion": {
      "type": "object",
      "required": ["duration", "easing", "reducedMotion"],
      "properties": {
        "duration": { "$ref": "#/$defs/stringMap" },
        "easing": { "$ref": "#/$defs/stringMap" },
        "reducedMotion": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "iconography": {
      "type": "object",
      "required": ["library", "size", "strokeWidth", "color"],
      "properties": {
        "library": { "type": "string", "minLength": 1 },
        "size": { "$ref": "#/$defs/stringMap" },
        "strokeWidth": { "type": "number", "exclusiveMinimum": 0 },
        "color": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "themes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9]*$" },
      "additionalProperties": { "$ref": "#/$defs/theme" }
    }
  },
  "$defs": {
    "cssLength": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?(?:px|rem|em|%)$"
    },
    "cssVariable": {
      "type": "string",
      "pattern": "^--[a-z][a-z0-9-]*$"
    },
    "fontFamily": {
      "type": "object",
      "required": ["cssVariable", "value", "role"],
      "properties": {
        "cssVariable": { "$ref": "#/$defs/cssVariable" },
        "value": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "fontWeight": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "cssVariable": { "$ref": "#/$defs/cssVariable" },
        "value": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "role": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "oklchChannel": {
      "type": "string",
      "pattern": "^(?:0(?:\\.[0-9]+)?|1(?:\\.0+)?) (?:0(?:\\.[0-9]+)?|1(?:\\.0+)?) -?[0-9]+(?:\\.[0-9]+)?$"
    },
    "hexAlphaColor": {
      "type": "string",
      "pattern": "^#[0-9A-F]{8}$"
    },
    "opacityValue": {
      "type": "string",
      "pattern": "^(?:0(?:\\.[0-9]+)?|1(?:\\.0+)?)$"
    },
    "modeToken": {
      "type": "object",
      "required": ["light", "dark", "role"],
      "properties": {
        "light": { "$ref": "#/$defs/modeValue" },
        "dark": { "$ref": "#/$defs/modeValue" },
        "role": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "modeValue": {
      "oneOf": [
        { "$ref": "#/$defs/oklchChannel" },
        { "$ref": "#/$defs/hexAlphaColor" },
        { "$ref": "#/$defs/opacityValue" }
      ]
    },
    "modeColor": {
      "type": "object",
      "required": ["light", "dark", "role"],
      "properties": {
        "light": {
          "oneOf": [
            { "$ref": "#/$defs/oklchChannel" },
            { "$ref": "#/$defs/hexAlphaColor" }
          ]
        },
        "dark": {
          "oneOf": [
            { "$ref": "#/$defs/oklchChannel" },
            { "$ref": "#/$defs/hexAlphaColor" }
          ]
        },
        "role": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "semanticColor": {
      "type": "object",
      "required": ["cssVariable", "light", "dark", "role"],
      "properties": {
        "cssVariable": { "$ref": "#/$defs/cssVariable" },
        "light": { "$ref": "#/$defs/oklchChannel" },
        "dark": { "$ref": "#/$defs/oklchChannel" },
        "role": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "stringMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "token": {
      "type": "object",
      "required": ["value", "role"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "coarse": {
          "type": "string",
          "pattern": "^\\{[a-z][a-z0-9.-]*\\}$"
        },
        "role": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "shadowLayer": {
      "type": "object",
      "required": ["offsetX", "offsetY", "blur", "spread", "color", "inset"],
      "properties": {
        "offsetX": { "type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$" },
        "offsetY": { "type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$" },
        "blur": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
        "spread": { "type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$" },
        "color": { "type": "string", "pattern": "^#[0-9A-F]{8}$" },
        "inset": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "shadowToken": {
      "type": "object",
      "required": ["role", "light", "dark"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "light": {
          "type": "array",
          "description": "Layers drawn in light mode. An empty list is no shadow.",
          "items": { "$ref": "#/$defs/shadowLayer" }
        },
        "dark": {
          "type": "array",
          "description": "Layers drawn in dark mode. An empty list is no shadow.",
          "items": { "$ref": "#/$defs/shadowLayer" }
        }
      },
      "additionalProperties": false
    },
    "tokenGroup": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/token" },
          { "$ref": "#/$defs/tokenGroup" }
        ]
      }
    },
    "themeColors": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/oklchChannel" }
    },
    "themeTypeScale": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "fontSize": { "$ref": "#/$defs/cssLength" },
        "lineHeight": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" }
      },
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "required": ["label", "description"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "defaultMode": { "enum": ["light", "dark"] },
        "color": {
          "type": "object",
          "required": ["light", "dark"],
          "properties": {
            "light": { "$ref": "#/$defs/themeColors" },
            "dark": { "$ref": "#/$defs/themeColors" }
          },
          "additionalProperties": false
        },
        "typography": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "fontFamily": { "$ref": "#/$defs/stringMap" },
            "fontWeight": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              }
            },
            "scale": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "$ref": "#/$defs/themeTypeScale" }
            }
          },
          "additionalProperties": false
        },
        "radius": { "$ref": "#/$defs/stringMap" },
        "opacity": { "$ref": "#/$defs/stringMap" }
      },
      "additionalProperties": false
    },
    "typeScale": {
      "type": "object",
      "required": [
        "cssVariable",
        "fontSize",
        "lineHeight",
        "lineHeightCssVariable"
      ],
      "properties": {
        "cssVariable": { "$ref": "#/$defs/cssVariable" },
        "fontSize": { "$ref": "#/$defs/cssLength" },
        "lineHeight": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
        "lineHeightCssVariable": { "$ref": "#/$defs/cssVariable" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
