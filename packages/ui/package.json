{
  "name": "@vllnt/ui",
  "version": "0.4.0",
  "description": "React component library — 313 components built on Radix UI, Tailwind CSS, and CVA",
  "license": "MIT",
  "author": "vllnt",
  "homepage": "https://ui.vllnt.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vllnt/ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/vllnt/ui/issues"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "radix-ui",
    "tailwindcss",
    "design-system",
    "shadcn"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./tailwind-preset": {
      "types": "./src/tailwind-preset.ts",
      "import": "./src/tailwind-preset.ts"
    },
    "./styles.css": "./styles.css",
    "./themes/default.css": "./themes/default.css",
    "./themes/presets.css": "./themes/presets.css"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./tailwind-preset": {
        "types": "./dist/tailwind-preset.d.ts",
        "import": "./dist/tailwind-preset.js"
      },
      "./styles.css": "./styles.css",
      "./themes/default.css": "./themes/default.css",
      "./themes/presets.css": "./themes/presets.css"
    }
  },
  "files": [
    "dist",
    "styles.css",
    "themes",
    "CHANGELOG.md",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist node_modules coverage .snapshots playwright-report test-results storybook-static",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint/ . --fix",
    "pack:check": "node scripts/check-packed-package.mjs",
    "check:circular": "madge --circular --extensions ts,tsx src",
    "check:atomic": "node ../../scripts/check-atomic-levels.mjs src/components",
    "test": "vitest",
    "test:once": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:visual": "playwright test -c playwright-ct.config.ts",
    "test:visual:update": "playwright test -c playwright-ct.config.ts --update-snapshots",
    "test:all": "pnpm test:coverage && pnpm test:visual",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook",
    "storybook:generate": "tsx scripts/generate-stories.ts",
    "storybook:generate-docs": "tsx scripts/generate-docs.ts",
    "storybook:verify": "tsx scripts/verify-stories.ts",
    "check:dist-imports": "node scripts/check-dist-imports.mjs",
    "check:use-client": "tsx scripts/check-use-client.ts",
    "size": "node scripts/check-size.mjs"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "next-themes": ">=0.4.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "tailwindcss": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@mdx-js/mdx": "^3.1.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "html-to-image": "^1.11.13",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.468.0",
    "qrcode": "1.5.4",
    "react-day-picker": "^9.14.0",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.8",
    "react-syntax-highlighter": "^16.1.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^1.7.4",
    "tailwindcss-animate": "^1.0.7",
    "tailwind-merge": "^2.6.1",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@github-ui/storybook-addon-performance-panel": "^1.3.1",
    "@playwright/experimental-ct-react": "~1.61.1",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-designs": "^12.0.0",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-mcp": "^0.3.4",
    "@storybook/addon-themes": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@storybook/test-runner": "^0.26.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitest/coverage-v8": "^5.0.5",
    "@vllnt/eslint-config": "^2.0.0",
    "@vllnt/typescript": "^2.0.0",
    "autoprefixer": "^10.6.1",
    "axe-core": "4.12.1",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "playwright": "~1.61.1",
    "postcss": "^8.5.31",
    "storybook": "^10.6.3",
    "tailwindcss": "^3.4.19",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
